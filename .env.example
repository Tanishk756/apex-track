# APEX-Track v15.0 Environment Variable Configuration Template
# Copy this file to .env and insert your real credentials.

# 1. Roboflow Universe API Key (Private or Publishable)
ROBOFLOW_API_KEY=your_roboflow_key_here

# 2. OpenAI API Key (For Tactical Copilot RAG Agent)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# 3. OpenWeatherMap API Key (For Meteorological Telemetry)
OPENWEATHER_API_KEY=your_openweather_key_here

# 4. System Environment Options
APEX_HOST=0.0.0.0
APEX_PORT=8000
APEX_DEBUG=false
